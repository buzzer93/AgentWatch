{% extends 'base.html.twig' %}

{% block title %}Tous les articles | AgentWatch{% endblock %}

{% block body %}
    <main class="relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-br from-amber-200 via-orange-100 to-emerald-100 blur-3xl"></div>

        <div class="mx-auto flex min-h-screen max-w-7xl flex-col px-6 py-10 lg:px-10">
            <header class="mb-8 rounded-[2rem] border border-black/5 bg-white/80 p-8 shadow-[0_20px_80px_rgba(17,24,39,0.08)] backdrop-blur">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                    <div class="space-y-2">
                        <a href="{{ path('app_dashboard') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-ember">
                            &larr; Retour au dashboard
                        </a>
                        <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Tous les articles</h1>
                        <p class="text-base leading-7 text-ink/70">
                            {{ total }} article{{ total > 1 ? 's' : '' }} en base, tri par date de publication decroissante.
                        </p>
                    </div>
                    <span class="inline-flex w-fit items-center rounded-full bg-ink/5 px-4 py-2 text-sm font-semibold text-ink">
                        Page {{ page }} / {{ totalPages }}
                    </span>
                </div>
            </header>

            <section class="rounded-[2rem] border border-black/5 bg-white p-2 shadow-[0_18px_60px_rgba(17,24,39,0.06)]">
                {% if items is empty %}
                    <div class="px-8 py-16 text-center">
                        <p class="text-lg font-semibold text-ink">Aucun article en base.</p>
                        <p class="mt-2 text-sm text-ink/60">Lance le workflow <span class="font-semibold">RSS Collect</span> dans n8n.</p>
                    </div>
                {% else %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-ink/10">
                            <thead>
                                <tr class="text-left text-xs font-semibold uppercase tracking-[0.2em] text-ink/50">
                                    <th class="px-4 py-3">Titre</th>
                                    <th class="px-4 py-3">Source</th>
                                    <th class="px-4 py-3">Publie le</th>
                                    <th class="px-4 py-3">Tags</th>
                                    <th class="px-4 py-3">Score</th>
                                    <th class="px-4 py-3">Statut</th>
                                    <th class="px-4 py-3 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-ink/5">
                                {% for item in items %}
                                    {% set analysis = item.analysis %}
                                    <tr class="text-sm hover:bg-ink/[0.02]">
                                        <td class="max-w-md px-4 py-3">
                                            <a href="{{ path('app_article_show', {id: item.id}) }}" class="font-semibold text-ink hover:text-ember">
                                                {{ analysis and analysis.translatedTitle ? analysis.translatedTitle : item.title }}
                                            </a>
                                        </td>
                                        <td class="px-4 py-3 text-ink/70">{{ item.source.name }}</td>
                                        <td class="px-4 py-3 text-xs font-mono text-ink/60">
                                            {% if item.publishedAt %}
                                                {{ item.publishedAt|date('d/m/Y') }}
                                            {% else %}
                                                <span class="text-ink/40">&mdash;</span>
                                            {% endif %}
                                        </td>
                                        <td class="px-4 py-3">
                                            {% if item.tags|length > 0 %}
                                                <div class="flex flex-wrap gap-1">
                                                    {% for tag in item.tags|slice(0, 3) %}
                                                        <span class="inline-flex items-center rounded-full bg-ember/10 px-2 py-0.5 text-xs font-semibold text-ember">{{ tag.name }}</span>
                                                    {% endfor %}
                                                    {% if item.tags|length > 3 %}
                                                        <span class="text-xs text-ink/40">+{{ item.tags|length - 3 }}</span>
                                                    {% endif %}
                                                </div>
                                            {% else %}
                                                <span class="text-xs text-ink/40">&mdash;</span>
                                            {% endif %}
                                        </td>
                                        <td class="px-4 py-3">
                                            {% if analysis %}
                                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-moss text-sm font-bold text-sand">{{ analysis.effectiveFinalScore }}</span>
                                            {% else %}
                                                <span class="text-xs text-ink/40">&mdash;</span>
                                            {% endif %}
                                        </td>
                                        <td class="px-4 py-3">
                                            {% if analysis %}
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-moss/10 px-2.5 py-0.5 text-xs font-semibold text-moss">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-moss"></span>
                                                    Analyse
                                                </span>
                                            {% else %}
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                                                    En attente
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td class="px-4 py-3 text-right">
                                            <a href="{{ path('app_article_show', {id: item.id}) }}" class="text-xs font-semibold text-ember hover:underline">
                                                Voir &rarr;
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>

            {% if totalPages > 1 %}
                <nav class="mt-6 flex items-center justify-between text-sm">
                    {% if page > 1 %}
                        <a href="{{ path('app_article_index', {page: page - 1}) }}" class="inline-flex items-center gap-2 rounded-full border border-ink/15 px-4 py-2 font-semibold text-ink/70 transition hover:bg-ink/5">
                            &larr; Precedente
                        </a>
                    {% else %}
                        <span></span>
                    {% endif %}

                    <span class="text-ink/60">Page {{ page }} sur {{ totalPages }} · {{ total }} articles au total</span>

                    {% if page < totalPages %}
                        <a href="{{ path('app_article_index', {page: page + 1}) }}" class="inline-flex items-center gap-2 rounded-full border border-ink/15 px-4 py-2 font-semibold text-ink/70 transition hover:bg-ink/5">
                            Suivante &rarr;
                        </a>
                    {% else %}
                        <span></span>
                    {% endif %}
                </nav>
            {% endif %}
        </div>
    </main>
{% endblock %}
