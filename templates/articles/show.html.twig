{% extends 'base.html.twig' %}

{% block title %}{{ analysis and analysis.translatedTitle ? analysis.translatedTitle : item.title }} | AgentWatch{% endblock %}

{% block body %}
    <main class="relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-br from-amber-200 via-orange-100 to-emerald-100 blur-3xl"></div>

        <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-6 py-10 lg:px-10">
            <a href="{{ path('app_dashboard') }}" class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-ember">
                &larr; Retour au dashboard
            </a>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mt-4 rounded-2xl border border-{{ label == 'success' ? 'moss' : 'red-500' }}/30 bg-{{ label == 'success' ? 'moss' : 'red-500' }}/10 px-5 py-3 text-sm font-semibold text-{{ label == 'success' ? 'moss' : 'red-700' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <article class="mt-6 space-y-8">
                <header class="rounded-[2rem] border border-black/5 bg-white p-8 shadow-[0_18px_60px_rgba(17,24,39,0.06)]">
                    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-ink/50">
                        <span class="text-ember">{{ item.source.name }}</span>
                        {% if item.publishedAt %}
                            <span>·</span>
                            <span>{{ item.publishedAt|date('d/m/Y') }}</span>
                        {% endif %}
                    </div>

                    {% if analysis and analysis.translatedTitle %}
                        <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{{ analysis.translatedTitle }}</h1>
                        <p class="mt-2 text-sm italic text-ink/50">Titre original : {{ item.title }}</p>
                    {% else %}
                        <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{{ item.title }}</h1>
                    {% endif %}

                    {% if item.author %}
                        <p class="mt-3 text-sm text-ink/60">Par <span class="font-semibold text-ink/80">{{ item.author }}</span></p>
                    {% endif %}

                    <div class="mt-6 flex flex-wrap gap-3">
                        <a
                            href="{{ item.url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-sand transition hover:bg-ink/90"
                        >
                            Lire l'article original &rarr;
                        </a>
                        {% if item.source.websiteUrl %}
                            <a
                                href="{{ item.source.websiteUrl }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold text-ink transition hover:bg-ink/5"
                            >
                                Voir la source
                            </a>
                        {% endif %}
                    </div>
                </header>

                {% if analysis %}
                    <section class="rounded-[2rem] border border-black/5 bg-white p-8 shadow-[0_18px_60px_rgba(17,24,39,0.06)]">
                        <div class="flex flex-wrap items-center justify-between gap-4">
                            <h2 class="text-xl font-bold">Analyse IA</h2>
                            <div class="flex items-center gap-3">
                                <span class="text-xs font-semibold uppercase tracking-[0.2em] text-ink/40">Score final</span>
                                <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-moss text-xl font-bold text-sand">{{ analysis.effectiveFinalScore }}</span>
                            </div>
                        </div>

                        <div class="mt-6 space-y-2">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ember">Resume</p>
                            <p class="text-base leading-7 text-ink/85">{{ analysis.summary }}</p>
                        </div>

                        {% if item.tags|length > 0 %}
                            <div class="mt-6 space-y-2">
                                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ember">Tags</p>
                                <div class="flex flex-wrap gap-1.5">
                                    {% for tag in item.tags %}
                                        <span class="inline-flex items-center rounded-full bg-ember/10 px-3 py-1 text-xs font-semibold text-ember">{{ tag.name }}</span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        <p class="mt-6 text-xs text-ink/40">
                            Analyse generee par {{ analysis.modelUsed }} le {{ analysis.createdAt|date('d/m/Y H:i') }}
                            {% if analysis.hasUserScores %}
                                · <span class="font-semibold text-moss">Scores corriges manuellement le {{ analysis.userScoresUpdatedAt|date('d/m/Y H:i') }}</span>
                            {% endif %}
                        </p>
                    </section>

                    <section class="rounded-[2rem] border border-black/5 bg-white p-8 shadow-[0_18px_60px_rgba(17,24,39,0.06)]">
                        <div class="flex items-center justify-between gap-4">
                            <div>
                                <h2 class="text-xl font-bold">Corriger les scores</h2>
                                <p class="mt-1 text-sm text-ink/60">Ajuste si l'IA s'est trompee. Tes corrections nourrissent l'apprentissage futur.</p>
                            </div>
                        </div>

                        <form method="post" action="{{ path('app_article_update_scores', {id: item.id}) }}" class="mt-6 space-y-5">
                            <input type="hidden" name="_token" value="{{ csrf_token('update-scores' ~ item.id) }}">

                            {% set scoreFields = [
                                {key: 'relevanceScore', label: 'Pertinence', ai: analysis.relevanceScore, user: analysis.userRelevanceScore},
                                {key: 'businessScore', label: 'Business', ai: analysis.businessScore, user: analysis.userBusinessScore},
                                {key: 'learningScore', label: 'Apprentissage', ai: analysis.learningScore, user: analysis.userLearningScore},
                                {key: 'contentScore', label: 'Contenu', ai: analysis.contentScore, user: analysis.userContentScore},
                                {key: 'finalScore', label: 'Score final', ai: analysis.finalScore, user: analysis.userFinalScore}
                            ] %}

                            {% for field in scoreFields %}
                                {% set currentValue = field.user is not null ? field.user : field.ai %}
                                <div class="space-y-2">
                                    <div class="flex items-baseline justify-between gap-3">
                                        <label for="score-{{ field.key }}" class="text-sm font-semibold text-ink">{{ field.label }}</label>
                                        <div class="flex items-center gap-3 text-xs">
                                            <span class="text-ink/50">IA : <span class="font-mono font-semibold text-ink/70">{{ field.ai }}</span></span>
                                            <span class="rounded-full bg-ink px-2.5 py-0.5 font-mono text-sm font-bold text-sand" data-value-for="{{ field.key }}">{{ currentValue }}</span>
                                        </div>
                                    </div>
                                    <input
                                        type="range"
                                        id="score-{{ field.key }}"
                                        name="{{ field.key }}"
                                        min="0"
                                        max="100"
                                        step="1"
                                        value="{{ currentValue }}"
                                        oninput="document.querySelector('[data-value-for=\'{{ field.key }}\']').textContent = this.value;"
                                        class="h-2 w-full cursor-pointer appearance-none rounded-full bg-ink/10 accent-ember"
                                    >
                                </div>
                            {% endfor %}

                            <div class="flex flex-wrap items-center gap-3 border-t border-black/5 pt-5">
                                <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-ember px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-ember/90">
                                    Enregistrer mes corrections
                                </button>
                            </div>
                        </form>

                        {% if analysis.hasUserScores %}
                            <form method="post" action="{{ path('app_article_reset_scores', {id: item.id}) }}" class="mt-3" onsubmit="return confirm('Reinitialiser aux scores IA ? Tes corrections seront perdues.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('reset-scores' ~ item.id) }}">
                                <button type="submit" class="inline-flex items-center gap-2 rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold text-ink/70 transition hover:bg-ink/5">
                                    Reinitialiser aux scores IA
                                </button>
                            </form>
                        {% endif %}
                    </section>
                {% else %}
                    <section class="rounded-[2rem] border border-dashed border-ink/15 bg-sand p-8">
                        <p class="text-base font-semibold">Analyse IA pas encore disponible</p>
                        <p class="mt-2 text-sm text-ink/60">Cet article n'a pas encore ete traite par le workflow <span class="font-semibold">Article Analysis</span>.</p>
                    </section>
                {% endif %}

            </article>
        </div>
    </main>
{% endblock %}
