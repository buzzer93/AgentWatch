{% extends 'base.html.twig' %}

{% block title %}Editer {{ prompt.name }} | AgentWatch{% endblock %}

{% block body %}
    <main class="relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-br from-amber-200 via-orange-100 to-emerald-100 blur-3xl"></div>

        <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-6 py-10 lg:px-10">
            <header class="mb-8 space-y-3">
                <a href="{{ path('app_prompt_index') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-ember">
                    &larr; Tous les prompts
                </a>
                <h1 class="text-3xl font-extrabold tracking-tight">{{ prompt.name }}</h1>
                <p class="text-sm text-ink/60">
                    Cle : <code class="rounded bg-ink/5 px-1.5 py-0.5 font-mono text-xs">{{ prompt.promptKey }}</code>
                    · Modifie le {{ prompt.updatedAt|date('d/m/Y H:i') }}
                </p>
            </header>

            <section class="rounded-[2rem] border border-black/5 bg-white p-8 shadow-[0_18px_60px_rgba(17,24,39,0.06)]">
                {% include 'prompt/_form.html.twig' %}
            </section>
        </div>
    </main>
{% endblock %}
