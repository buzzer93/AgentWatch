{% extends 'base.html.twig' %}

{% block title %}Tags | AgentWatch{% endblock %}

{% block body %}
    <main class="relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-br from-amber-200 via-orange-100 to-emerald-100 blur-3xl"></div>

        <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-6 py-10 lg:px-10">
            <header class="mb-8 rounded-[2rem] border border-black/5 bg-white/80 p-8 shadow-[0_20px_80px_rgba(17,24,39,0.08)] backdrop-blur">
                <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                    <div class="max-w-2xl space-y-3">
                        <a href="{{ path('app_dashboard') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-ember">
                            &larr; Retour au dashboard
                        </a>
                        <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Tags</h1>
                        <p class="text-base leading-7 text-ink/70">
                            Les tags servent a regrouper sources et articles par theme. Un meme tag est partage entre les deux.
                        </p>
                    </div>
                    <a href="{{ path('app_tag_new') }}" class="inline-flex w-fit items-center justify-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-sand transition hover:bg-ink/90">
                        + Ajouter un tag
                    </a>
                </div>
            </header>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-2xl border border-{{ label == 'success' ? 'moss' : 'red-500' }}/30 bg-{{ label == 'success' ? 'moss' : 'red-500' }}/10 px-5 py-3 text-sm font-semibold text-{{ label == 'success' ? 'moss' : 'red-700' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <section class="rounded-[2rem] border border-black/5 bg-white p-2 shadow-[0_18px_60px_rgba(17,24,39,0.06)]">
                {% if tags is empty %}
                    <div class="px-8 py-16 text-center">
                        <p class="text-lg font-semibold text-ink">Aucun tag pour le moment.</p>
                        <p class="mt-2 text-sm text-ink/60">Ajoute des tags pour categoriser tes sources RSS.</p>
                        <a href="{{ path('app_tag_new') }}" class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-ember px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-ember/90">
                            Ajouter un tag
                        </a>
                    </div>
                {% else %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-ink/10">
                            <thead>
                                <tr class="text-left text-xs font-semibold uppercase tracking-[0.2em] text-ink/50">
                                    <th class="px-6 py-4">Nom</th>
                                    <th class="px-6 py-4">Slug</th>
                                    <th class="px-6 py-4">Sources</th>
                                    <th class="px-6 py-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-ink/5">
                                {% for tag in tags %}
                                    <tr class="text-sm">
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center rounded-full bg-ember/10 px-3 py-1 text-xs font-semibold text-ember">{{ tag.name }}</span>
                                        </td>
                                        <td class="px-6 py-4 font-mono text-xs text-ink/60">{{ tag.slug }}</td>
                                        <td class="px-6 py-4 text-sm text-ink/70">{{ tag.rssSources|length }}</td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center justify-end gap-2">
                                                <a href="{{ path('app_tag_edit', {id: tag.id}) }}" class="rounded-full bg-ink/5 px-3 py-1.5 text-xs font-semibold text-ink transition hover:bg-ink/10">
                                                    Editer
                                                </a>
                                                <form method="post" action="{{ path('app_tag_delete', {id: tag.id}) }}" onsubmit="return confirm('Supprimer le tag &quot;{{ tag.name|e('js') }}&quot; ? Il sera retire de toutes les sources.');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                                                    <button type="submit" class="rounded-full border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-50">
                                                        Supprimer
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </div>
    </main>
{% endblock %}
